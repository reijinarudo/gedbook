# Copy this file to .env and fill in your own values.
# Every setting can also be given on the command line or in gedbook.toml.
# No API keys or accounts are needed; gedbook runs entirely on your computer.

# Path to the GEDCOM file exported from your family tree program or website.
GEDBOOK_GEDCOM=path/to/your_tree.ged

# Folder of photos and documents (searched recursively).
GEDBOOK_MEDIA=path/to/your_photos

# The person the book is built around (usually you). Find it with: gedbook find your_tree.ged "Your Name"
GEDBOOK_ROOT=I1

# Where book.html, book.pdf, and media_matches.csv are written.
GEDBOOK_OUT=book_output
